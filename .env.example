# ===== AI Service (Groq Cloud) =====
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=llama-3.1-8b-instant
GROQ_MAX_TOKENS=2000
GROQ_TEMPERATURE=0.7

GEMINI_API_KEY=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_MAX_TOKENS=2000
GEMINI_TEMPERATURE=0.3
GEMINI_AUTO_KEY_ROTATION=true

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_MAX_TOKENS=2000
OLLAMA_TEMPERATURE=0.3
OLLAMA_TIMEOUT=30


# ===== Database (Neon DB) =====
NEON_DATABASE_URL=
NEON_POOL_SIZE=5
NEON_MAX_OVERFLOW=10
NEON_POOL_TIMEOUT=30

# ===== Cache (Redis Cloud) =====
REDIS_URL=
REDIS_DECODE_RESPONSES=true
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# ===== Application Settings =====
APP_NAME=Aiden
USER_NAME=Sir
WAKE_WORD=aiden
HOTKEY=ctrl+shift+space
TOGGLE_HOTKEY=ctrl+.
STOP_LISTENING_HOTKEY=ctrl+shift+/
DEBUG=false
APP_TRAY_SHOW_RESTART=false
SETTINGS_ENCRYPTION_KEY=
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_TUNNEL_METRICS_PORT=20240

# ===== API Server =====
API_HOST=localhost
API_PORT=5000
API_RELOAD=false

# ===== Speech Settings =====
SPEECH_TTS_PROVIDER=edge
SPEECH_TTS_VOICE=en-US-AriaNeural
SPEECH_TTS_RATE=1.0
SPEECH_GOOGLE_TTS_CREDENTIALS_PATH=
SPEECH_GOOGLE_TTS_VOICE=en-US-Chirp-HD-F
SPEECH_GOOGLE_TTS_PITCH=0.0
SPEECH_GOOGLE_TTS_SPEAKING_RATE=1.0
SPEECH_STT_LANGUAGE=en-US
SPEECH_STT_TIMEOUT=5
SPEECH_STT_PAUSE_THRESHOLD=0.9
SPEECH_STT_NON_SPEAKING_DURATION=0.7
SPEECH_STT_DEVICE_INDEX=
SPEECH_STT_ENERGY_THRESHOLD=600
SPEECH_PENDING_CLARIFICATION_GRACE_SECONDS=60
SPEECH_VOSK_MODEL_PATH=vosk_models/vosk-model-small-en-us-0.15
APP_ENABLE_ENHANCED_RESPONSES=false

# ===== ESP32 Smart Home =====
ESP32_ENABLED=true
ESP32_IP_ADDRESS=192.168.1.180
ESP32_TIMEOUT=5
ESP32_RETRY_ATTEMPTS=3

# ===== Cache Configuration =====
LLM_PROVIDER=gemini
ENABLE_CACHING=true
CACHE_TTL_CONTEXT=300
CACHE_TTL_APP_PATHS=86400
CACHE_TTL_LLM_RESPONSE=3600
CACHE_TTL_TTS_AUDIO=3600


SPEECH_PORCUPINE_ACCESS_KEY=
SPEECH_PORCUPINE_MODEL_PATH=
SPEECH_PORCUPINE_SENSITIVITY=0.5
SPEECH_USE_PORCUPINE=true
SPEECH_PORCUPINE_MIN_ENERGY=200.0
SPEECH_PORCUPINE_DEBOUNCE_SECONDS=2.0
SPEECH_PORCUPINE_CONFIRMATION_WINDOW=0.2

# ===== openWakeWord (replaces Porcupine — no API key, fewer false positives) =====
# Set SPEECH_USE_OPENWAKEWORD=true to switch (keep SPEECH_USE_PORCUPINE=false)
# Train a custom "Hey Hayden" model: https://colab.research.google.com/drive/1q1oe2zOyZp7UsB3jJiQ1IFn8z5YfjwEb
SPEECH_USE_OPENWAKEWORD=false
SPEECH_OWW_MODEL_PATH=                # leave blank to use pre-trained models, or set path to .onnx file
SPEECH_OWW_THRESHOLD=0.5              # activation confidence threshold (0-1)
SPEECH_OWW_VAD_THRESHOLD=0.3          # Silero VAD gate — raises bar for noisy env; 0 = disabled
SPEECH_INPUT_DEVICE_NAME=USB PnP Audio Device
SPEECH_OWW_VERIFIER_PATH=             # optional personal verifier .pkl
SPEECH_OWW_VERIFIER_GATE=0.25         # base-model score that invokes the verifier
SPEECH_OWW_STRONG_THRESHOLD=0.75      # one-frame immediate activation
SPEECH_OWW_SMOOTHING_WINDOW=3         # rolling prediction frames
SPEECH_OWW_SMOOTHING_HITS=2           # normal-threshold hits required in the window
SPEECH_OWW_CONTINUATION_WINDOW_MS=300 # detect "Aiden, do something" continuation; 0 disables it
SPEECH_OWW_PROFILE_PATH=              # ignored calibrated JSON profile
SPEECH_OWW_SHADOW_MODE=false          # score/log without activating
SPEECH_OWW_CAPTURE_DIAGNOSTICS=false  # save local WAV clips only when explicitly enabled

# Silero VAD (more accurate than WebRTC; requires torch - set false to use WebRTC fallback)
SPEECH_STT_USE_SILERO_VAD=true
SPEECH_STT_SILERO_THRESHOLD=0.5
# WebRTC VAD aggressiveness 0-3 (used only when Silero unavailable; 2 = balanced)
SPEECH_STT_VAD_AGGRESSIVENESS=2


# ===== Spotify Configuration =====
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# ===== UPS Power Monitoring =====
UPS_ENABLED=true
UPS_INFO_LOG_PATH=C:\ViewPower\log\info.log
UPS_POLLING_INTERVAL=1.0

# Legacy settings (no longer used - now time-based)
# UPS_ALERT_THRESHOLD=80
# UPS_CRITICAL_THRESHOLD=50
# UPS_SHUTDOWN_THRESHOLD=50
# UPS_SHUTDOWN_TIMEOUT=120

# ===== Jellyfin Media Monitoring =====
JELLYFIN_URL=http://localhost:8096
JELLYFIN_API_KEY=
